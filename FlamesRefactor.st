!PaletteGenerator commentStamp: 'jmi 3/22/2021 20:40' prior: 0!!!PaletteGenerator methodsFor: 'private' stamp: 'jmi 7/28/2020 13:54'!getColorFromCurve: c factor: f1  factor: f2 factor: f3	"Simplify the palette generation porocess by using a function based on a single color.	It's hard to explain, but I noticed that the hand crafted palettes foloowed a pattern, so I figured out the general solution"	| hasRed hasGreen hasBlue R G B cTemp |		hasRed := c red > 0.	hasGreen := c green > 0.	hasBlue := c blue > 0.		R := c red.	G := c green.	B := c blue.		(hasRed & hasGreen & hasBlue) ifTrue: [		"GetColorForThree_Old(ref R, ref G, ref B, factor1, factor2, factor3);"			cTemp := Color r: R g: G b: B.			cTemp := self getColorFromCurveTertiary: cTemp factor: f1 factor: f2 factor: f3.			R := cTemp red.			G := cTemp green.			B := cTemp blue.	] ifFalse: [			(hasRed & hasGreen not & hasBlue) ifTrue: [			 "Violets or Magentas"			"GetColorForSecondary_Old(ref B, ref R, ref G, factor1, factor2, factor3);"			cTemp := Color r: R g: B b: G. "NOTE: I had to switch the order for some reason"			cTemp := self getColorFromCurveSecondary: cTemp factor: f1 factor: f2 factor: f3.			R := cTemp red.			G := cTemp blue.			B := cTemp green.		].		(hasRed not & hasGreen & hasBlue) ifTrue: [			"Cyans"			"GetColorForSecondary_Old(ref B, ref G, ref R, factor1, factor2, factor3);"			cTemp := Color r: B g: G b: R.			cTemp := self getColorFromCurveSecondary: cTemp factor: f1 factor: f2 factor: f3.			R := cTemp blue.			G := cTemp green.			B := cTemp red.		].		(hasRed & hasGreen & hasBlue not) ifTrue: [			 "Yellows or Oranges"			"GetColorForSecondary_Old(ref R, ref G, ref B, factor1, factor2, factor3);"			"TODO: JRDV: EXPERIMANTAL... I forgot to implement this and the previous ones!!!!!!!!"			cTemp := Color r: R g: G b: B.			cTemp := self getColorFromCurveSecondary: cTemp factor: f1 factor: f2 factor: f3.			R := cTemp red.			G := cTemp green.			B := cTemp blue.		].		(hasRed & hasGreen not & hasBlue not) ifTrue: [			 "Reds"			"GetColorForPrimary_Old(ref R, ref B, ref G, factor1, factor2, factor3);"			cTemp := Color r: R g: B b: G.			cTemp := self getColorFromCurvePrimary: cTemp factor: f1 factor: f2 factor: f3.			R := cTemp red.			G := cTemp blue.			B := cTemp green.		].		(hasRed not & hasGreen & hasBlue not) ifTrue: [			 "Greens"			"GetColorForPrimary_Old(ref G, ref B, ref R, factor1, factor2, factor3);"			cTemp := Color r: G g: B b: R.			cTemp := self getColorFromCurvePrimary: cTemp factor: f1 factor: f2 factor: f3.			R := cTemp blue.			G := cTemp red.			B := cTemp green.		].		(hasRed not & hasGreen not & hasBlue) ifTrue: [			 "Blues"			"GetColorForPrimary_Old(ref B, ref G, ref R, factor1, factor2, factor3);"			cTemp := Color r: B g: G b: R.			cTemp := self getColorFromCurvePrimary: cTemp factor: f1 factor: f2 factor: f3.			R := cTemp blue.			G := cTemp green.			B := cTemp red.		].	].		^ Color r: R g: G b: B.! !!PaletteGenerator methodsFor: 'private' stamp: 'jmi 4/2/2020 13:09'!getColorFromCurvePrimary: c factor: factor1  factor: factor2 factor: factor3	"Simplify the palette generation porocess by using a function based on a single color.	It's hard to explain, but I noticed that the hand crafted palettes foloowed a pattern, so I figured out the general solution"	"TODO: Could implement the first parameter as a tuple, as 'smuggling' this through a color object is confusing.  I just want to do calculations based on relative weights, not the actual colors in this function"	"This function calculates a color with a single component that is given most consideration.... wait I'm wording that wrong.  One component is stronger than the other two"	| primary secondary tertiary |		primary := c red.	secondary := c green.	tertiary := c blue.	primary := primary * factor1.	secondary := ((secondary * 255) +  factor2) /255.	(secondary > 1) ifTrue: [secondary := 1].	tertiary := (secondary * factor3)."			primary = (int)(primary * factor1);			secondary += factor2;			//secondary = secondary + (int)(primary * factor2 / 255.0f);			if (secondary > 255)				secondary = 255;			tertiary = (int)(secondary * factor3);"		^ Color r: primary g: secondary b: tertiary.! !!PaletteGenerator methodsFor: 'private' stamp: 'jmi 4/2/2020 13:10'!getColorFromCurveSecondary: c factor: factor1  factor: factor2 factor: factor3	"Simplify the palette generation porocess by using a function based on a single color.	It's hard to explain, but I noticed that the hand crafted palettes foloowed a pattern, so I figured out the general solution"	"TODO: Could implement the first parameter as a tuple, as 'smuggling' this through a color object is confusing.  I just want to do calculations based on relative weights, not the actual colors in this function"	"This function calculates a color with two strong components that are given most consideration.... wait I'm wording that wrong.  One component is weaker than the other two"	| primary secondary tertiary |	primary := c red.	secondary := c green.	tertiary := c blue.		primary := primary * factor1.	secondary := secondary * factor1.	tertiary := ((tertiary * 255) +  factor2) /255.	(tertiary > 1) ifTrue: [tertiary := 1]."			primary1 = (int)(primary1 * factor1);			primary2 = (int)(primary2 * factor1);			//secondary = secondary * ((float)factor2) ; // TODO: JRDV: this should be a multiplication? Yes, try it next. The color curve is currently off when the primary color is not 255			secondary += factor2;			if (secondary > 255)				secondary = 255;"		^ Color r: primary g: secondary b: tertiary.! !!PaletteGenerator methodsFor: 'private' stamp: 'jmi 4/2/2020 13:05'!getColorFromCurveTertiary: c factor: f1  factor: f2 factor: f3	"Simplify the palette generation porocess by using a function based on a single color.	It's hard to explain, but I noticed that the hand crafted palettes foloowed a pattern, so I figured out the general solution"	| primary secondary tertiary cTemp isRedLeast isGreenLeast |	isRedLeast := false.	isGreenLeast := false.		(c red <= c green)	 ifTrue: [		(c red <= c blue) ifTrue: [ isRedLeast := true. ]	] ifFalse: [		(c green <= c blue) ifTrue: [ isGreenLeast := true. ]	].	cTemp := Color new.	isRedLeast ifTrue: [		primary:= c green.		secondary := c blue.		tertiary := c red.			].	isGreenLeast ifTrue: [		primary := c red.		secondary := c blue.		tertiary := c green.			]	ifFalse: [ "BLUE is Least"		primary := c red.		secondary := c green.		tertiary := c blue.			].		"TODO: Could implement this call with a tuple, as 'smuggling' this through a color object is confusing"	cTemp := Color r: primary g: secondary b: tertiary.	cTemp := self getColorFromCurveSecondary: cTemp factor: f1 factor: f2 factor: f3.	"unpack back to the real colors"	primary := cTemp red.	secondary := cTemp green.	tertiary := cTemp blue.		isRedLeast ifTrue: [		cTemp := Color r: tertiary g: primary b: secondary.		].	isGreenLeast ifTrue: [		cTemp := Color r: primary g: tertiary b: secondary.		]	ifFalse: [ "BLUE is Least"		cTemp := Color r: primary g: secondary b: tertiary.		].	"			bool fRedLeast = false;			bool fGreenLeast = false;			if (R <= G)			{				if (R <= B)					fRedLeast = true;			}			else if (G <= B)				fGreenLeast = true;			if (fRedLeast)				GetColorForThreeHelper_Old(ref G, ref B, ref R, factor1, factor2, factor3);			else if (fGreenLeast)				GetColorForThreeHelper_Old(ref R, ref B, ref G, factor1, factor2, factor3);			else //if (fBlueLeast)				GetColorForThreeHelper_Old(ref R, ref G, ref B, factor1, factor2, factor3);"		^ cTemp.! !!PaletteGenerator methodsFor: 'private' stamp: 'jmi 4/2/2020 12:22'!getColorFromCurveTertiaryHelper: c factor: f1  factor: f2 factor: f3	"DEPRECATED!! DELETE THIS!!  Just call the secondary method!! Simplify the palette generation porocess by using a function based on a